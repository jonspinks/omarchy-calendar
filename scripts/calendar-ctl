#!/usr/bin/env -S python3 -B
"""Omarchy Calendar: account sign-in and a read test (phase 0).

    calendar-ctl add-google <name> <client_secret.json>
    calendar-ctl add-microsoft <name> --tenant <tenant-id> --client-id <app-id>
    calendar-ctl list
    calendar-ctl test <name>          # the next five events, to prove access
    calendar-ctl sync [--full]        # bring the local copy up to date
    calendar-ctl calendars            # every calendar, and which are shown
    calendar-ctl choose               # pick them all at once, in a checklist
    calendar-ctl hide|show <account> <number, name or id>
    calendar-ctl remove <name>
    calendar-ctl respond <uid> accept|tentative|decline [--series]
    calendar-ctl create <account>/<calendar id> --title <t> --start <when> [--end <when>]
                 [--all-day] [--location <text>] [--invite <email>]... [--busy | --free]
    calendar-ctl update <uid> [--title <t>] [--start <when>] [--end <when>]
                 [--all-day | --timed] [--location <text>] [--busy | --free] [--series]
    calendar-ctl delete <uid> [--series]

A uid is as in events.json. Times are local ("2026-10-02 14:30") unless they
carry an offset; with --all-day they are dates, and the end is the day after
the last (it defaults to one day, or one hour for a timed event).

Secrets never touch disk here. Each account's refresh token (and, for Google,
the OAuth client secret) is stored in the GNOME keyring through secret-tool,
under service=blacksheep.calendar account=<name>. The config file holds only
what is not secret: names, providers, tenant and client IDs.

Google signs in through the browser (installed-app flow with PKCE, redirected
to a one-shot listener on 127.0.0.1). Microsoft uses the device-code flow: no
listener, no browser redirect, and nothing to paste but a short code.
"""

import os
import sys
import urllib.parse
from datetime import datetime, timedelta, timezone

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from omcal.auth import *  # noqa: E402,F401,F403
from omcal.auth import AuthError, HttpError  # noqa: E402

# -------------------------------------------------------------- commands

def cmd_test(name):
    a = account(name)
    now = datetime.now(timezone.utc)
    rows = []
    if a["provider"] == "google":
        tok = google_access(a)
        q = urllib.parse.urlencode({"timeMin": now.isoformat(), "singleEvents": "true",
                                    "orderBy": "startTime", "maxResults": 5})
        for e in get_json("https://www.googleapis.com/calendar/v3/calendars/primary/events?" + q, tok).get("items", []):
            st = e.get("start", {})
            rows.append((st.get("dateTime") or st.get("date", ""), e.get("summary", "(no title)"),
                         "Meet" if e.get("hangoutLink") else ""))
    else:
        tok = ms_access(a)
        q = urllib.parse.urlencode({"startDateTime": now.isoformat(),
                                    "endDateTime": (now + timedelta(days=30)).isoformat(),
                                    "$top": 5, "$orderby": "start/dateTime",
                                    "$select": "subject,start,isOnlineMeeting,onlineMeetingProvider"})
        for e in get_json("https://graph.microsoft.com/v1.0/me/calendarView?" + q, tok).get("value", []):
            rows.append((e["start"]["dateTime"][:16] + " " + e["start"].get("timeZone", ""),
                         e.get("subject") or "(no title)",
                         "Teams" if e.get("isOnlineMeeting") else ""))
    print("%s (%s): read access works.\n" % (name, a.get("email", "")))
    if not rows:
        print("  (no upcoming events)")
    for when, title, link in rows:
        print("  %-28s %s%s" % (when[:28], title, "  [" + link + "]" if link else ""))


def known_calendars():
    """(account, id, name, shown, editable, events) for every calendar, from the last sync."""
    from omcal import sync
    d = sync.read_json(os.path.join(sync.CACHE, "events.json"), {})
    counts = {}
    for e in d.get("events", []):
        counts[(e["account"], e["calendar"])] = counts.get((e["account"], e["calendar"]), 0) + 1
    return [(c["account"], c["id"], c["name"], c.get("shown", True), c.get("editable", False),
             counts.get((c["account"], c["id"]), 0)) for c in d.get("calendars", [])]


def cmd_calendars():
    rows = known_calendars()
    if not rows:
        die("no calendars yet: run calendar-ctl sync first")
    last = None
    for acc, cid, name, shown, editable, n in rows:
        if acc != last:
            print("%s%s" % ("" if last is None else "\n", acc))
            last, i = acc, 0
        i += 1
        print("  %2d  [%s] %-34s %s%s" % (i, "x" if shown else " ", name[:34],
              "%d events" % n if shown else "hidden", "" if editable else ", read-only"))
    print("\ncalendar-ctl hide|show <account> <number or name>")


def cmd_pick():
    """Every calendar in one checklist (gum), ticked if shown; saves the lot."""
    import shutil
    import subprocess
    rows = known_calendars()
    if not rows:
        die("no calendars yet: run calendar-ctl sync first")
    if not shutil.which("gum"):
        die("the picker needs gum, which Omarchy ships; or use calendar-ctl hide|show")
    # gum returns the chosen labels, and splits --selected on commas, so each
    # label carries its row number and no commas of its own.
    labels = ["%2d  %s · %s%s" % (i + 1, acc, name.replace(",", " "), "" if editable else "  (read-only)")
              for i, (acc, cid, name, shown, editable, n) in enumerate(rows)]
    selected = [l for l, r in zip(labels, rows) if r[3]]
    p = subprocess.run(["gum", "choose", "--no-limit", "--height", str(min(len(rows) + 2, 30)),
                        # gum 2.0 toggles with x or tab; space does nothing.
                        "--header", "Calendars to show   x or tab: toggle   enter: save   esc: cancel",
                        "--show-help",
                        "--selected", ",".join(selected)] + labels,
                       stdout=subprocess.PIPE, text=True)
    if p.returncode != 0:
        print("Nothing changed.")
        return
    chosen = {int(line.split()[0]) - 1 for line in p.stdout.splitlines() if line.strip()}
    hidden = {}
    for i, (acc, cid, name, shown, editable, n) in enumerate(rows):
        if i not in chosen:
            hidden.setdefault(acc, set()).add(cid)
    before = hidden_calendars()
    if {k: v for k, v in before.items() if v} == hidden:
        print("Nothing changed.")
        return
    save_hidden(hidden)
    print("Showing %d of %d calendars. Syncing..." % (len(chosen), len(rows)))
    from omcal import sync
    sync.main(["sync", "--quiet"])


def cmd_choose(show, acc, which):
    rows = [r for r in known_calendars() if r[0] == acc]
    if not rows:
        die("no calendars for %r (check calendar-ctl calendars)" % acc)
    pick = rows[int(which) - 1] if which.isdigit() and 1 <= int(which) <= len(rows) else \
        next((r for r in rows if r[1] == which or r[2].lower() == which.lower()), None)
    if not pick:
        die("%s has no calendar %r" % (acc, which))
    hidden = hidden_calendars()
    ids = hidden.setdefault(acc, set())
    (ids.discard if show else ids.add)(pick[1])
    save_hidden(hidden)
    print("%s %s: %s. Syncing..." % ("Showing" if show else "Hiding", acc, pick[2]))
    from omcal import sync
    sync.main(["sync", "--quiet"])


def event_options(args, cmd):
    """--flag value pairs. A value is taken as it is, even if it starts with a
    dash, so a title from anywhere can't turn into an option."""
    opt, it = {}, iter(args)
    names = {"--title": "title", "--start": "start", "--end": "end", "--location": "location"}
    for x in it:
        if x in names:
            v = next(it, None)
            if v is None:
                die("%s needs a value" % x)
            opt[names[x]] = v
        elif x == "--invite":
            v = next(it, None)
            if not v or "@" not in v:
                die("--invite needs an email address")
            opt.setdefault("invite", []).append(v)
        elif x in ("--all-day", "--timed"):
            opt["all_day"] = x == "--all-day"
        elif x in ("--busy", "--free"):
            opt["busy"] = x == "--busy"
        elif x == "--series":
            opt["series"] = True
        else:
            die("usage: see calendar-ctl --help")
    return opt


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd, args = argv[1], argv[2:]
    if cmd == "add-google" and len(args) == 2:
        add_google(*args)
    elif cmd == "add-microsoft" and len(args) == 5 and args[1] == "--tenant" and args[3] == "--client-id":
        add_microsoft(args[0], args[2], args[4])
    elif cmd == "list" and not args:
        for a in load_accounts():
            print("%-16s %-10s %s" % (a["name"], a["provider"], a.get("email", "")))
    elif cmd == "test" and len(args) == 1:
        cmd_test(args[0])
    elif cmd == "sync" and all(x in ("--full", "--quiet") for x in args):
        from omcal import sync
        sys.exit(sync.main(["sync"] + args))
    elif cmd == "calendars" and not args:
        cmd_calendars()
    elif cmd == "choose" and not args:
        cmd_pick()
    elif cmd in ("hide", "show") and len(args) == 2:
        cmd_choose(cmd == "show", *args)
    elif cmd == "respond" and len(args) in (2, 3) and args[2:] in ([], ["--series"]):
        from omcal import edit, sync
        edit.respond(args[0], args[1], series=bool(args[2:]))
        print("Answered %s." % args[1])
        sync.main(["sync", "--quiet"])
    elif cmd in ("create", "update") and args:
        from omcal import edit, sync
        opt = event_options(args[1:], cmd)
        if cmd == "create":
            if "start" not in opt:
                die("create needs --start")
            opt.setdefault("title", "")
            opt["invite"] = opt.pop("invite", [])
            opt.pop("series", None)
            print(edit.create(args[0], **opt))
        else:
            if opt.pop("invite", None):
                die("--invite is for create")
            edit.update(args[0], **opt)
            print("Saved.")
        sync.main(["sync", "--quiet"])
    elif cmd == "delete" and len(args) in (1, 2) and args[1:] in ([], ["--series"]):
        from omcal import edit, sync
        edit.delete(args[0], series=bool(args[1:]))
        print("Deleted.")
        sync.main(["sync", "--quiet"])
    elif cmd == "remove" and len(args) == 1:
        save_accounts([a for a in load_accounts() if a["name"] != args[0]])
        secret_clear(args[0])
        print("Removed %s." % args[0])
    else:
        die("usage: see calendar-ctl --help")


if __name__ == "__main__":
    try:
        main(sys.argv)
    except (AuthError, HttpError, RuntimeError) as e:
        die(str(e))
